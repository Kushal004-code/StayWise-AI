# ==============================================================================
# StayWise AI - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env` and fill in your local values.
# NEVER commit your actual `.env` file or real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL 18 Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=staywise_db
POSTGRES_USER=your_postgres_username_here
POSTGRES_PASSWORD=your_postgres_password_here

# ------------------------------------------------------------------------------
# 2. Main Backend Configuration (Java 21 / Spring Boot)
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/staywise_db
SPRING_DATASOURCE_USERNAME=your_postgres_username_here
SPRING_DATASOURCE_PASSWORD=your_postgres_password_here
FRONTEND_CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. JWT Authentication Configuration
# ------------------------------------------------------------------------------
# Use a minimum 256-bit (32+ characters) random base64/hex string in local .env
JWT_SECRET_KEY=replace_with_a_secure_256_bit_secret_key_placeholder
JWT_ACCESS_TOKEN_EXPIRATION_MS=3600000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# ------------------------------------------------------------------------------
# 4. AI Backend Configuration (Python 3.12 / FastAPI)
# ------------------------------------------------------------------------------
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_ENV=development
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_INTERNAL_API_KEY=replace_with_internal_service_key_placeholder

# ------------------------------------------------------------------------------
# 5. AI / LLM & RAG Configuration
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini_or_openai_placeholder
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL_NAME=gemini-1.5-flash
EMBEDDING_MODEL_NAME=text-embedding-004
VECTOR_STORE_PATH=./vector_store
