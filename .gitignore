# ==============================================================================
# StayWise AI - Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Files & Secrets (CRITICAL - Never commit real credentials)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.jks
secrets/

# ------------------------------------------------------------------------------
# 2. Java / Maven / Spring Boot (backend/)
# ------------------------------------------------------------------------------
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
*.class
*.log
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# ------------------------------------------------------------------------------
# 3. Node.js / React / Vite / TypeScript (frontend/)
# ------------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
.vite/
.npm/
.eslintcache
.tsbuildinfo
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 4. Python / FastAPI / AI & RAG (ai-service/)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
# Local vector store / RAG caches
chroma_db/
faiss_index/
vector_store/

# ------------------------------------------------------------------------------
# 5. Python Virtual Environments
# ------------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 6. IDEs & Code Editors
# ------------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# ------------------------------------------------------------------------------
# 7. OS-Generated Files (Windows, macOS, Linux)
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory
.Trash-*
